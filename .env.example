# Bu dosya örnek amaçlıdır — gerçek değerlerle doldurulmuş bir .env dosyası ASLA commit edilmemelidir.

# --- Ortam ---
NODE_ENV=development
PORT=4000

# --- MongoDB Atlas ---
ATLAS_URI_DEV=
ATLAS_URI_STAGING=
ATLAS_URI_PROD=

# --- JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Medya Depolama (R2 veya S3) ---
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- VPS / Deploy ---
VPS_HOST=
VPS_SSH_KEY=

# --- İzleme ---
SENTRY_DSN=

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# Bu dosya örnek amaçlıdır — gerçek değerlerle doldurulmuş bir .env dosyası ASLA commit edilmemelidir.

# --- Ortam ---
NODE_ENV=development
PORT=4000

# --- MongoDB Atlas ---
ATLAS_URI_DEV=
ATLAS_URI_STAGING=
ATLAS_URI_PROD=

# --- JWT ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- CORS (virgülle ayrılmış izinli origin listesi) ---
CORS_ALLOWED_ORIGINS=http://localhost:8081

# --- Rate limiting ---
AUTH_RATE_LIMIT_MAX=10

# --- Medya Depolama (R2 veya S3) ---
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- Claude API (KYC OCR/belge doğrulama) ---
ANTHROPIC_API_KEY=

# --- E-posta (SMTP — bildirimler) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- VPS / Deploy ---
VPS_HOST=
VPS_SSH_KEY=

# --- İzleme ---
SENTRY_DSN=

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379
